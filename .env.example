# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://your-app.onrender.com)
# Used for self-referential links and OAuth callback URLs.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET:
# Required for "Login with GitHub" OAuth 2.0 flow.
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set Authorization callback URL to: <YOUR_APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
